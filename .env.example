# Образец для запуска всего проекта. Для своих настроек скопируйте в корневой .env.
# Сам корневой .env.example не загружается Compose как файл настроек.
# На новом окружении проект запускается без .env и без ключа AI.
# Строки с # — комментарии: они не задают и не удаляют переменные окружения.
# Публичные пароли ниже предназначены для локального демо на 127.0.0.1.

# Порты браузерного интерфейса и API на вашем компьютере.
FRONTEND_PORT=3000
PORT=3001
NODE_ENV=development
# PostgreSQL запускается через Compose; DATABASE_URL для контейнеров собирается автоматически.
POSTGRES_USER=career_quest
POSTGRES_PASSWORD=change-this-local-database-password
POSTGRES_DB=career_quest
# Секрет подписи токенов входа, не ключ AI. Минимум 32 символа; срок токена — в секундах.
JWT_SECRET=change-me-to-a-unique-random-secret-of-at-least-32-characters
JWT_TTL_SECONDS=3600
# Создать отсутствующие демо-аккаунты. Пароли существующих аккаунтов не меняются.
DEMO_MODE=true
DEMO_HR_USERNAME=hr
DEMO_HR_PASSWORD=change-this-demo-hr-password
DEMO_EMPLOYEE_USERNAME=employee
DEMO_EMPLOYEE_PASSWORD=change-this-demo-employee-password
DEMO_EMPLOYEE_ID=E0001
# Полный синтетический набор: 200 сотрудников, 40 активностей, 60 навыков.
# DATA_MODE=fixtures выбирает небольшой тестовый набор backend.
# Для него нужен DEMO_EMPLOYEE_ID=fixture_person_a и отдельная база.
DATA_MODE=input
# Путь к данным на хосте относительно backend/; файлы уже есть в репозитории.
INPUT_DATA_DIR=../frontend/app/data
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Необязательно: без AS_OF_DATE используется дата среза набора.
# Не задавайте пустые AS_OF_DATE или LLM_BASE_URL — оставьте строку комментарием.
# AS_OF_DATE=2026-10-01

# disabled: подбор по правилам, без вызовов модели; LLM_API_KEY не нужен и не используется.
# openai: нужны настоящий LLM_API_KEY и ALLOW_EXTERNAL_LLM=true.
# local: нужен отдельно запущенный Ollama и установленная модель в LLM_MODEL.
# Отсутствие ключа OpenAI не останавливает API: подбор вернётся к правилам.
LLM_PROVIDER=disabled
# gpt-4.1-mini — настройка OpenAI; для local укажите имя своей модели Ollama.
LLM_MODEL=gpt-4.1-mini
# Для OpenAI URL можно не задавать: используется https://api.openai.com/v1.
# Следующий URL — пример для Ollama на хосте Docker Desktop, не для OpenAI.
# Этот hostname в текущем адаптере также требует ALLOW_EXTERNAL_LLM=true.
# LLM_BASE_URL=http://host.docker.internal:11434
# Только в .env: для openai удалите # и замените плейсхолдер настоящим ключом.
# Для Ollama ключ нужен лишь при требовании авторизации на его сервере.
# Один ключ не включает AI — также измените LLM_PROVIDER и разрешение ниже.
# LLM_API_KEY=replace-with-your-real-provider-key
# Таймаут модели в миллисекундах: 100–6000; при превышении — подбор по правилам.
LLM_TIMEOUT_MS=5000
# false запрещает облачный OpenAI и Ollama по адресу вне loopback/localhost.
ALLOW_EXTERNAL_LLM=false
# После изменения .env: docker compose up --build -d, затем «Подобрать заново» в UI.

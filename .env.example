# Optional: copy to .env in the repository root to override local defaults.
# These are public LOCAL credentials. Both published ports bind to 127.0.0.1.
FRONTEND_PORT=3000
PORT=3001
NODE_ENV=development
POSTGRES_USER=career_quest
POSTGRES_PASSWORD=change-this-local-database-password
POSTGRES_DB=career_quest
JWT_SECRET=change-me-to-a-unique-random-secret-of-at-least-32-characters
JWT_TTL_SECONDS=3600
DEMO_MODE=true
DEMO_HR_USERNAME=hr
DEMO_HR_PASSWORD=change-this-demo-hr-password
DEMO_EMPLOYEE_USERNAME=employee
DEMO_EMPLOYEE_PASSWORD=change-this-demo-employee-password
DEMO_EMPLOYEE_ID=fixture_person_a
# Explicit synthetic backend fixture dataset; no external keys are needed.
DATA_MODE=fixtures
# Relative to backend/, since the backend Compose file owns this bind mount.
INPUT_DATA_DIR=./data/input
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Omit optional date/URL variables instead of assigning an empty string.
# AS_OF_DATE=2026-10-01
LLM_PROVIDER=disabled
LLM_MODEL=gpt-4.1-mini
# LLM_BASE_URL=http://host.docker.internal:11434
# LLM_API_KEY=provide-only-if-the-selected-provider-requires-it
LLM_TIMEOUT_MS=5000
ALLOW_EXTERNAL_LLM=false

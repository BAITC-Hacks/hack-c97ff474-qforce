# Copy to .env; use long unique secrets. Demo mode must remain false in production.
NODE_ENV=development
PORT=3001
POSTGRES_USER=career_quest
POSTGRES_PASSWORD=change-this-local-database-password
POSTGRES_DB=career_quest
# For local Node process; Compose overrides hostname to its private postgres service.
DATABASE_URL=postgresql://career_quest:change-this-local-database-password@127.0.0.1:5432/career_quest?schema=public
# Dedicated disposable test DB only; integration tests reject any name not ending _test.
TEST_DATABASE_URL=postgresql://career_quest_test:isolated-test-password@127.0.0.1:55432/career_quest_test?schema=public
JWT_SECRET=change-me-to-a-unique-random-secret-of-at-least-32-characters
DEMO_MODE=true
DEMO_HR_USERNAME=hr
DEMO_HR_PASSWORD=change-this-demo-hr-password
DEMO_EMPLOYEE_USERNAME=employee
DEMO_EMPLOYEE_PASSWORD=change-this-demo-employee-password
# Fixture mode: fixture_person_a; official dataset: choose an existing external ID.
DEMO_EMPLOYEE_ID=fixture_person_a
DATA_MODE=fixtures
INPUT_DATA_DIR=./data/input
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Empty means dataset as_of_date, not the wall clock; do not rewrite historical dates.
# AS_OF_DATE=2026-10-01
LLM_PROVIDER=disabled
LLM_MODEL=gpt-4.1-mini
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_API_KEY=set-only-when-required
LLM_TIMEOUT_MS=5000
ALLOW_EXTERNAL_LLM=false

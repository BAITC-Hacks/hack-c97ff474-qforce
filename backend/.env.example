# Пример для backend: скопируйте в backend/.env, если файла ещё нет.
# Backend Compose читает этот пример как базовые настройки; backend/.env их переопределяет.
# Для всего проекта используйте корневой .env.example и корневой .env.
# В production нужны собственные секреты и DEMO_MODE=false.
# Строка с # — комментарий, она не задаёт и не удаляет переменную.
NODE_ENV=development
PORT=3001
POSTGRES_USER=career_quest
POSTGRES_PASSWORD=change-this-local-database-password
POSTGRES_DB=career_quest
# Для Node.js-процесса нужна отдельная доступная БД по DATABASE_URL.
# Compose формирует свой DATABASE_URL; его PostgreSQL не публикует порт хоста.
DATABASE_URL=postgresql://career_quest:change-this-local-database-password@127.0.0.1:5432/career_quest?schema=public
# Только отдельная тестовая БД; integration/E2E требуют имя с окончанием _test.
TEST_DATABASE_URL=postgresql://career_quest_test:isolated-test-password@127.0.0.1:55432/career_quest_test?schema=public
JWT_SECRET=change-me-to-a-unique-random-secret-of-at-least-32-characters
DEMO_MODE=true
DEMO_HR_USERNAME=hr
DEMO_HR_PASSWORD=change-this-demo-hr-password
DEMO_EMPLOYEE_USERNAME=employee
DEMO_EMPLOYEE_PASSWORD=change-this-demo-employee-password
# Для fixtures: fixture_person_a; для другого набора — ID существующего сотрудника.
DEMO_EMPLOYEE_ID=fixture_person_a
DATA_MODE=fixtures
INPUT_DATA_DIR=./data/input
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Без AS_OF_DATE используется дата среза набора, а не системные часы.
# Пустое значение недопустимо: оставьте строку комментарием, если дата не нужна.
# AS_OF_DATE=2026-10-01
# disabled: подбор по правилам; ключ не нужен и не используется.
# openai: нужны настоящий LLM_API_KEY и ALLOW_EXTERNAL_LLM=true.
# local: нужен запущенный Ollama и установленная модель в LLM_MODEL.
# Ошибка/отсутствие ключа OpenAI приводит к подбору по правилам, не остановке API.
LLM_PROVIDER=disabled
# Для local замените на имя своей установленной модели Ollama.
LLM_MODEL=gpt-4.1-mini
# OpenAI без LLM_BASE_URL использует https://api.openai.com/v1.
# Адрес ниже — Ollama рядом с Node.js-процессом; внутри Docker это сам контейнер API.
# Не задавайте пустой URL. Другой hostname требует ALLOW_EXTERNAL_LLM=true.
# LLM_BASE_URL=http://127.0.0.1:11434
# В backend/.env удалите # и замените значение настоящим ключом при выборе openai.
# Для Ollama ключ нужен только при авторизации на его сервере. Один ключ не включает AI.
# LLM_API_KEY=replace-with-your-real-provider-key
# Таймаут модели: 100–6000 мс; при превышении — подбор по правилам.
LLM_TIMEOUT_MS=5000
ALLOW_EXTERNAL_LLM=false
